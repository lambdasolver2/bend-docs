---
interface Props {
  title: string;
  description: string;
  canonical: string;
  mdMirror?: string;
  toc?: { id: string; text: string; depth: number }[];
}
import { SITE_NAV } from "../lib/site-nav";
import { SITE } from "../lib/site";
const { title, description, canonical, mdMirror, toc } = Astro.props;
const site = SITE;
const url = new URL(canonical, site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/stix-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/stix-latin-italic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {mdMirror && <link rel="alternate" type="text/markdown" href={mdMirror} />}
    <link rel="describedby" href="/llms.txt" />
    <script is:inline>
      try {
        const t = localStorage.theme;
        if (t === "paper" || t === "board")
          document.documentElement.dataset.theme = t;
      } catch {
        /* storage unavailable: system preference applies */
      }
    </script>
    <style is:global>
      @font-face {
        font-family: "STIX Two Text";
        src: url("/fonts/stix-latin.woff2") format("woff2");
        font-weight: 400 700;
        font-style: normal;
        font-display: optional;
      }
      @font-face {
        font-family: "STIX Two Text";
        src: url("/fonts/stix-latin-italic.woff2") format("woff2");
        font-weight: 400 700;
        font-style: italic;
        font-display: optional;
      }
      :root {
        color-scheme: light dark;
        --paper: #fffdf7;
        --ink: #161512;
        --muted: #6e6a60;
        --accent: #0e4d27;
        --link: #0b57d0;
        --link-hover: #bd2a33;
        --rule: #ddd;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --paper: #22262b;
          --ink: #e8e6de;
          --muted: #9a978e;
          --accent: #4cc38a;
          --link: #8ab4ff;
          --link-hover: #ff8a80;
          --rule: #444;
        }
      }
      :root[data-theme="paper"] {
        color-scheme: light;
        --paper: #fffdf7;
        --ink: #161512;
        --muted: #6e6a60;
        --accent: #0e4d27;
        --link: #0b57d0;
        --link-hover: #bd2a33;
        --rule: #ddd;
      }
      :root[data-theme="board"] {
        color-scheme: dark;
        --paper: #22262b;
        --ink: #e8e6de;
        --muted: #9a978e;
        --accent: #4cc38a;
        --link: #8ab4ff;
        --link-hover: #ff8a80;
        --rule: #444;
      }
      * { box-sizing: border-box; }
      html { background: var(--paper); color: var(--ink); font-size: 112.5%; }
      body {
        font-family: "STIX Two Text", Georgia, "Times New Roman", serif;
        margin: 0;
        font-size: 1.125rem;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }
      main, footer { max-width: min(1480px, 96vw); margin-inline: auto; }
      main { padding-block: 1.5rem 2rem; }
      .running-head { max-width: min(1480px, 96vw); margin-inline: auto; padding-top: 0.5rem; }
      .rh-inner {
        border-bottom: 1px solid var(--ink);
        display: flex; justify-content: space-between; align-items: baseline;
        padding-bottom: 0.35rem; font-size: 0.85rem;
      }
      .running-head a { color: var(--muted); text-decoration: none; }
      .running-head a:hover { text-decoration: underline; }
      .site { letter-spacing: 0.04em; font-variant-caps: small-caps; color: var(--ink); }
      h1 {
        font-size: clamp(2.2rem, 5vw, 3.2rem);
        line-height: 1.1;
        font-weight: normal;
        margin: 1.5rem 0 1rem;
        overflow-wrap: break-word;
      }
      main > h1:first-child { border-bottom: 3px solid var(--accent); padding-bottom: 0.5rem; }
      h2 { font-family: Arial, Helvetica, sans-serif; font-size: 1.3rem; margin: 2rem 0 0.75rem; }
      h3 { font-size: 1.1rem; font-style: italic; }
      p { margin: 0 0 1.25rem; }
      a { color: var(--link); text-underline-offset: 2px; }
      a:hover { color: var(--link-hover); text-decoration: none; }
      main ul, main ol { margin: 0 0 1.25rem; }
      main ul { list-style-type: disc; }
      code, pre { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 0.9em; }
      code:not(pre code) {
        background: color-mix(in srgb, var(--muted) 14%, var(--paper));
        border-radius: 0;
        padding: 0.1em 0.35em;
      }
      pre.astro-code {
        position: relative;
        border-radius: 0;
        border: 1px solid color-mix(in srgb, var(--muted) 40%, transparent);
        padding: 1.1rem 1.25rem;
        margin: 1.5em 0;
        overflow-x: auto;
        tab-size: 2;
        line-height: 1.55;
      }
      .codewrap { position: relative; margin: 1.5em 0; }
      .codewrap > pre.astro-code { margin: 0; }
      pre.astro-code:not([data-language="plaintext"])::after {
        content: attr(data-language);
        position: absolute;
        top: 0.45rem;
        left: 0.9rem;
        font-size: 0.68rem;
        letter-spacing: 0.06em;
        color: #9da5ae;
      }
      .copy-code {
        position: absolute; top: 0.45rem; right: 0.6rem; z-index: 1;
        min-width: 3.6rem; text-align: center;
        border: 1px solid #59636e; border-radius: 0; background: #24292e;
        color: #c9d1d9; cursor: pointer; font: 0.68rem ui-monospace, monospace;
        padding: 0.2rem 0.45rem;
      }
      .copy-code:hover { color: #fff; border-color: #fff; }
      .copy-code:focus-visible { outline: 2px solid #8ab4ff; outline-offset: 1px; }
      .copy-code[data-copied="true"] { color: #7ee787; border-color: #7ee787; }
      table { border-collapse: collapse; margin: 1.5rem 0; font-size: 0.95rem; display: block; overflow-x: auto; }
      th, td { text-align: left; vertical-align: top; padding: 0.4rem 1.1rem 0.4rem 0; }
      thead th { border-top: 1.5px solid var(--ink); border-bottom: 1px solid var(--ink); }
      .badge { display: inline-block; font-size: 0.8rem; border-radius: 0; padding: 0.15rem 0.7rem; color: #fff; background: var(--accent); margin-bottom: 1rem; }
      .box { border: 1px solid var(--ink); border-top-width: 3px; padding: 0.7rem 1rem 0.8rem; margin: 1.5em 0; background: transparent; }
      .box p:first-child { margin-top: 0; }
      .box p:last-child { margin-bottom: 0; }
      .box > b:first-child { display: block; font-family: Arial, Helvetica, sans-serif; font-size: 0.72rem; font-weight: bold; letter-spacing: 0.09em; text-transform: uppercase; margin-bottom: 0.45rem; }
      .box-key { border-top-color: var(--accent); }
      .box-key > b:first-child { color: var(--accent); }
      .box-warn { border-top-color: color-mix(in srgb, #b3541e 75%, var(--ink)); }
      .box-warn > b:first-child { color: color-mix(in srgb, #b3541e 75%, var(--ink)); }
      .box-info { border-top-color: var(--muted); }
      .box-info > b:first-child { color: var(--muted); }
      .label { white-space: nowrap; font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 0.85em; padding: 0.1em 0.4em; border-radius: 0; }
      .label-fn { background: #c00; color: #fff; }
      .label-ty { background: #519179; color: #fff; }
      .label-cl { background: #c3c; color: #fff; }
      .label-law { background: #9dc; color: #000; }
      ol.chapters { list-style: none; padding-left: 0; }
      ol.chapters > li { margin-bottom: 2.2rem; }
      ol.chapters .part { font-family: Georgia, serif; color: var(--ink); }
      .part-heading { display: flex; align-items: baseline; gap: 0.9rem; border-bottom: 1px solid var(--rule); padding-bottom: 0.4rem; }
      .part-heading h3 { margin: 0; font-family: Arial, Helvetica, sans-serif; font-size: 1.25rem; font-style: normal; font-weight: 600; }
      .reference-chapter { margin: 0 0 2.5rem; }
      .reference-chapter .part-heading h2 { margin: 0; font-family: Arial, Helvetica, sans-serif; font-size: 1.35rem; font-style: normal; font-weight: 600; }
      .reference-chapter ol { list-style: none; padding: 0; margin: 0; }
      .reference-chapter li { display: flex; align-items: baseline; gap: 0.8rem; border-bottom: 1px solid var(--rule); padding: 0.38rem 0; }
      .reference-chapter li a { color: var(--ink); text-decoration: none; }
      .reference-chapter li a:hover { color: var(--link-hover); text-decoration: underline; }
      ol.chapters .part-no {
        display: inline-block; min-width: 2.2rem;
        font-family: Arial, Helvetica, sans-serif; font-weight: bold;
        font-size: 1.5rem; color: var(--accent); margin-right: 0.4rem;
      }
      .part-blurb { color: var(--muted); font-size: 0.95rem; margin: 0.55rem 0 0.35rem; }
      .content-no { color: var(--accent); font-family: Arial, Helvetica, sans-serif; font-size: 0.78rem; font-variant-numeric: tabular-nums; min-width: 3rem; }
      .curriculum-under-part { margin-top: 2.5rem; border-top: 2px solid var(--ink); padding-top: 1rem; }
      .curriculum-under-part > h3 { margin: 0; font-family: Arial, Helvetica, sans-serif; font-size: 1.15rem; font-style: normal; }
      .advanced-under-part { margin-top: 2rem; border-top: 1px solid var(--rule); padding-top: 0.75rem; }
      .advanced-under-part h3 { font-family: Arial, Helvetica, sans-serif; font-size: 1rem; margin: 0.5rem 0; }
      .advanced-under-part ul { list-style: none; padding: 0; }
      .advanced-under-part li { display: flex; align-items: baseline; gap: 0.65rem; margin: 0.35rem 0; }
      .curriculum-group h4 { font-family: Arial, Helvetica, sans-serif; font-size: 1rem; margin: 1.4rem 0 0.25rem; }
      ol.chapters > li > ul { line-height: 1.9; }
      ol.chapters > li > ul > li { list-style-type: none; font-size: 1rem; display: flex; align-items: baseline; gap: 0.6rem; }
      ol.chapters > li > ul > li > a { color: var(--ink); }
      ol.chapters > li > ul > li > a:hover { color: var(--link-hover); text-decoration: underline; }
      .curriculum-list { list-style: none; padding: 0; margin: 0; }
      .curriculum-list li { display: flex; align-items: baseline; gap: 0.75rem; border-bottom: 1px solid var(--rule); padding: 0.35rem 0; }
      .curriculum-no { color: var(--accent); font-family: Arial, Helvetica, sans-serif; font-size: 0.78rem; font-variant-numeric: tabular-nums; min-width: 2rem; }
      .curriculum-list time { color: var(--muted); font-size: 0.78rem; margin-left: auto; font-variant-numeric: tabular-nums; }
      .footdiv { width: 100%; display: table; margin: 2.5rem 0 1rem; border-top: 1px solid var(--ink); padding-top: 0.75rem; }
      .footdiv ul { display: table-row; margin: 0; padding: 0; list-style: none; }
      .footdiv ul li { display: table-cell; width: 33%; }
      .footdiv ul li:nth-child(1) { text-align: left; }
      .footdiv ul li:nth-child(2) { text-align: center; }
      .footdiv ul li:nth-child(3) { text-align: right; }
      .prevlink::before { content: "← "; }
      .nxtlink::after { content: " →"; }
      .meta { color: var(--muted); font-size: 0.85rem; }
      .prereq { border-top: 1px solid var(--ink); padding-top: 1rem; margin: 1.5em 0; }
      .prereq p:first-child { font-family: Arial, Helvetica, sans-serif; font-weight: bold; margin-bottom: 0.5rem; }
      .prereq ul { list-style-type: disc; }
      .prereq ul li::marker { color: var(--link); }
      .doc-layout { display: grid; grid-template-columns: 220px minmax(0, 960px) 220px; gap: 2rem; justify-content: center; align-items: start; }
      .doc-main { min-width: 0; width: 100%; }
      .toc-rail { position: sticky; top: 1rem; max-height: calc(100vh - 2rem); overflow: auto; font-size: 0.82rem; padding: 0 0.75rem 1rem; overscroll-behavior: contain; }
      .global-toc { border-right: 1px solid var(--rule); padding-left: 0; }
      .page-toc { border-left: 1px solid var(--rule); padding-right: 0; }
      .toc-rail p { font-family: Arial, Helvetica, sans-serif; font-weight: bold; font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 0.65rem; color: var(--muted); }
      .toc-rail .nav-section { margin: 0 0 1.2rem; }
      .toc-rail .nav-section > a, .toc-rail .nav-group-title { display: block; font-family: Arial, Helvetica, sans-serif; font-weight: bold; color: var(--ink); margin: 0.65rem 0 0.25rem; text-decoration: none; }
      .toc-rail ul { list-style: none; margin: 0; padding: 0; }
      .toc-rail li { margin: 0; line-height: 1.35; }
      .toc-rail li a { display: block; padding: 0.18rem 0; color: var(--muted); text-decoration: none; }
      .toc-rail li a:hover { color: var(--link-hover); }
      .page-toc li { padding-left: 0.7rem; }
      .mobile-doc-nav, .mobile-page-nav { display: none; }
      @media (max-width: 1024px) {
        .doc-layout { grid-template-columns: minmax(0, 960px) 220px; }
        .doc-main { max-width: 960px; margin-inline: auto; }
        .global-toc { display: none; }
        .page-toc { display: block; }
        .mobile-doc-nav { display: block; border-block: 1px solid var(--rule); margin: 0 0 1.5rem; }
        .mobile-page-nav { display: none; }
        .mobile-doc-nav summary { cursor: pointer; padding: 0.65rem 0; font-family: Arial, Helvetica, sans-serif; font-size: 0.78rem; font-weight: bold; letter-spacing: 0.06em; text-transform: uppercase; }
        .mobile-doc-nav > ul { list-style: none; padding: 0 0 0.8rem; margin: 0; columns: 2; column-gap: 1.5rem; }
        .mobile-doc-nav > ul > li { break-inside: avoid; margin: 0.3rem 0 0.8rem; }
        .mobile-doc-nav > ul > li > ul { list-style: none; padding: 0; margin: 0.25rem 0 0; columns: 1; }
        .mobile-doc-nav > ul > li > ul > li { margin: 0.2rem 0; }
        .mobile-doc-nav a { text-decoration: none; color: var(--muted); font-size: 0.9rem; }
      }
      @media (max-width: 560px) {
        body { font-size: 1rem; line-height: 1.6; }
        main, footer { max-width: none; width: 100%; padding-inline: 1rem; }
        .running-head { max-width: none; padding-inline: 1rem; }
        h1 { font-size: 2.2rem; }
        .doc-layout { display: block; }
        .page-toc { display: none; }
        .mobile-page-nav { display: none; }
        .mobile-doc-nav > ul { columns: 1; }
        .footdiv ul, .footdiv ul li { display: block; width: 100%; }
        .footdiv ul li { margin: 0.4rem 0; text-align: left !important; }
      }
      figure { margin: 1.75rem 0; }
      figure svg { max-width: 100%; height: auto; display: block; }
      figcaption { color: var(--muted); margin-top: 0.4rem; font-size: 0.85rem; }
      footer { color: var(--muted); font-size: 0.85rem; padding-block: 1rem 2.5rem; }
      footer a { color: var(--muted); }
      footer p { margin: 0.35rem 0; }
      .themes { display: flex; gap: 0.5rem; margin-top: 0.75rem; }
      .themes button {
        font: inherit; font-size: 0.8rem; cursor: pointer; background: var(--paper);
        color: var(--ink); border: 1px solid var(--ink); padding: 0.25rem 0.6rem;
      }
      .themes button[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
      @media print { :root { --paper: #fff; --ink: #000; --muted: #333; --link: #000; } .themes, .footdiv, .copy-code { display: none; } }
    </style>

  </head>
  <body>
    <header class="running-head">
      <div class="rh-inner">
        <a href="/" class="site">bend-docs</a>
        <a href="/contents/">Contents</a>
      </div>
    </header>
    <main>
      <details class="mobile-doc-nav">
        <summary>Documentation contents</summary>
        {SITE_NAV.map((section) => (
          <ul>
            {section.groups.map((group) => (
              <li>
                <strong>{group.title}</strong>
                <ul>
                  {group.items.map((item) => <li><a href={item.href}>{item.title}</a></li>)}
                </ul>
              </li>
            ))}
          </ul>
        ))}
      </details>
      {toc && toc.length > 0 && <details class="mobile-page-nav">
        <summary>On this page</summary>
        <ul>{toc.map((h) => <li><a href={`#${h.id}`}>{h.text}</a></li>)}</ul>
      </details>}
      <div class="doc-layout">
        <aside class="toc-rail global-toc" data-rail="documentation" aria-label="Documentation navigation">
            <p>Documentation</p>
            {SITE_NAV.map((section) => (
              <div class="nav-section">
                <a href="/contents/">{section.title}</a>
                {section.groups.map((group) => (
                  <div>
                    <span class="nav-group-title">{group.title}</span>
                    <ul>{group.items.map((item) => <li><a href={item.href}>{item.title}</a></li>)}</ul>
                  </div>
                ))}
              </div>
            ))}
        </aside>
        <div class="doc-main">
          <slot />
        </div>
        {toc && toc.length > 0 && (
        <aside class="toc-rail page-toc" data-rail="page" aria-label="On this page">
          <p>On this page</p>
          <ul>{toc.map((h) => <li><a href={`#${h.id}`}>{h.text}</a></li>)}</ul>
        </aside>
        )}
      </div>
    </main>
    <footer>
      <p>Unofficial Bend documentation. Not affiliated with Higher Order Company.</p>
      <p><a href="/contents/">Contents</a> · <a href="/llms.txt">llms.txt</a></p>
      <div class="themes" role="group" aria-label="Color theme">
        <button data-mode="paper" title="Paper (click again for system)">Paper</button>
        <button data-mode="board" title="Blackboard (click again for system)">Blackboard</button>
      </div>
      <script is:inline>
        (() => {
          const installCopyButtons = () => {
            document.querySelectorAll("pre.astro-code:not([data-copy-ready])").forEach((pre) => {
              pre.setAttribute("data-copy-ready", "true");
              const wrap = document.createElement("div");
              wrap.className = "codewrap";
              pre.replaceWith(wrap);
              wrap.append(pre);
              const button = document.createElement("button");
              button.className = "copy-code";
              button.type = "button";
              button.textContent = "Copy";
              button.setAttribute("aria-label", "Copy code");
              button.setAttribute("aria-live", "polite");
              let resetTimer;
              const done = (label) => {
                button.textContent = label;
                button.dataset.copied = "true";
                clearTimeout(resetTimer);
                resetTimer = setTimeout(() => {
                  button.textContent = "Copy";
                  delete button.dataset.copied;
                }, 1400);
              };
              button.addEventListener("click", async () => {
                const codeEl = pre.querySelector("code");
                const code = codeEl?.innerText ?? "";
                try {
                  await navigator.clipboard.writeText(code);
                  done("Copied");
                } catch {
                  if (codeEl) {
                    const range = document.createRange();
                    range.selectNodeContents(codeEl);
                    const sel = getSelection();
                    sel?.removeAllRanges();
                    sel?.addRange(range);
                  }
                  done("Selected");
                }
              });
              wrap.append(button);
            });
          };
          if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", installCopyButtons, { once: true });
          } else {
            installCopyButtons();
          }
        })();
        (() => {
          document.querySelectorAll(".toc-rail[data-rail]").forEach((rail) => {
            const key = `bend-docs:rail-scroll:${rail.getAttribute("data-rail")}:v3`;
            const save = () => {
              try { localStorage.setItem(key, String(rail.scrollTop)); } catch { /* storage unavailable */ }
            };
            const restore = () => {
              try {
                const saved = Number(localStorage.getItem(key));
                if (Number.isFinite(saved)) rail.scrollTop = saved;
              } catch { /* storage unavailable */ }
            };
            let frame;
            rail.addEventListener("scroll", () => {
              cancelAnimationFrame(frame);
              frame = requestAnimationFrame(save);
            }, { passive: true });
            rail.addEventListener("click", save);
            addEventListener("pagehide", save);
            addEventListener("pageshow", () => {
              restore();
              requestAnimationFrame(() => requestAnimationFrame(restore));
              setTimeout(restore, 100);
            });
            restore();
            requestAnimationFrame(() => requestAnimationFrame(restore));
            setTimeout(restore, 100);
          });
        })();
        (() => {
          const root = document.documentElement;
          const group = document.querySelector(".themes");
          const buttons = group.querySelectorAll("button");
          const MODES = ["paper", "board"];
          const sync = () => {
            let mode = "auto";
            try {
              if (MODES.includes(localStorage.theme)) mode = localStorage.theme;
            } catch { /* stay on auto */ }
            if (mode === "auto") delete root.dataset.theme;
            else root.dataset.theme = mode;
            buttons.forEach((b) =>
              b.setAttribute("aria-pressed", String(b.dataset.mode === mode)));
          };
          buttons.forEach((b) =>
            b.addEventListener("click", () => {
              const next =
                root.dataset.theme === b.dataset.mode ? "auto" : b.dataset.mode;
              try {
                if (next === "auto") localStorage.removeItem("theme");
                else localStorage.theme = next;
              } catch { /* this page only */ }
              sync();
            }));
          addEventListener("pageshow", sync);
          sync();
        })();
      </script>
    </footer>
  </body>
</html>
