---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const notes = (await getCollection("notes")).sort((a, b) =>
  a.data.title.localeCompare(b.data.title));
---

<Base
  title="Notes"
  description="Concept notes: interaction nets, the HVM4 runtime, search, proofs, and Bend2."
  canonical="/notes/"
  mdMirror="/notes/index.md"
>
  <h1>Notes</h1>
  <ul>
    {notes.map((n) => (
      <li>
        <a href={`/notes/${n.id.replace(/\.md$/, '')}/`}>{n.data.title}</a>
        <span class="meta"> · {n.data.status}</span>
      </li>
    ))}
  </ul>
</Base>
