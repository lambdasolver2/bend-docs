---
import Base from "../../layouts/Base.astro";
import { CURRICULUM_GROUPS as groups } from "../../lib/curriculum";
---

<Base
  title="Learn by example"
  description="The 45-item Bend2 curriculum: first programs, data, parallelism, proofs, synthesis, effects. New Bend2 syntax throughout, HVM4 runnable today."
  canonical="/learn/"
  mdMirror="/learn/index.md"
>
  <h1>Learn by example</h1>
  <div class="box box-warn">
    <b>Status.</b> Bend2 has no public compiler, so its samples are
    documentation-only in new Bend2 syntax — extrapolated shapes are
    flagged on each page. The
    <a href="/learn/hvm-hands-on/">HVM4 hands-on</a> page runs today,
    outputs verified.
  </div>
  {groups.map((g) => (
    <section>
      <h2>{g.name}</h2>
      <ol class="curriculum-list">
        {g.items.map((it) => (
          <li>
            <span class="curriculum-no">{it.n}</span>
            <a href={it.page}>{it.title}</a>
            {it.updated && <time datetime={it.updated}>{it.updated}</time>}
          </li>
        ))}
      </ol>
    </section>
  ))}
</Base>
