---
import Base from "../layouts/Base.astro";
import { PARTS as parts } from "../lib/order";
---

<Base
  title="Contents"
  description="The Bend documentation reference: ten chapters covering the language, proofs, parallel execution, HVM4, and comparisons."
  canonical="/contents/"
  mdMirror="/contents/index.md"
>
  <h1>Table of Contents</h1>
  <p class="lede">A structured reference for learning Bend2 and understanding the HVM4 runtime.</p>

  <nav class="reference-toc" aria-label="Documentation table of contents">
    {parts.map((part) => (
      <section class="reference-chapter">
        <div class="part-heading">
          <span class="part-no">{part.no}</span>
          <h2>{part.title}</h2>
        </div>
        <p class="part-blurb">{part.blurb}</p>
        <ol>
          {part.items.map((item) => (
            <li>
              <span class="content-no">{item.no}</span>
              <a href={item.href}>{item.title}</a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </nav>

  <div class="footdiv">
    <ul>
      <li><a class="prevlink" href="/">Home</a></li>
      <li><a href="/contents/">Contents</a></li>
      <li><a class="nxtlink" href="/notes/what-is-bend2/">What is Bend2?</a></li>
    </ul>
  </div>
</Base>
